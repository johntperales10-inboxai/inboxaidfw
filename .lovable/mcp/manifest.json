{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ukhdsaxoqgoeqwaioxir.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "inboxai-mcp",
      "version": "0.1.0",
      "title": "InboxAI"
    },
    "tools": [
      {
        "name": "list_reviews",
        "title": "List customer reviews",
        "description": "Return public customer reviews for the InboxAI Gmail agent product, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum number of reviews to return (default 20, max 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "submit_review",
        "title": "Submit a review",
        "description": "Post a new public customer review for the InboxAI Gmail agent product.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "description": "Reviewer's first name."
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Star rating, 1 to 5."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Review text, up to 300 characters."
            }
          },
          "required": [
            "first_name",
            "rating",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "generate_agent_script",
        "title": "Generate Gmail agent script",
        "description": "Generate a ready-to-paste Google Apps Script for the InboxAI Gmail agent, customized with the caller's Gemini API key and preferences.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "geminiApiKey": {
              "description": "Gemini API key starting with AIzaSy... If omitted, a placeholder is left in the script.",
              "type": "string"
            },
            "trustedSenders": {
              "description": "Email addresses or substrings whose messages should always be starred.",
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "trustedDomains": {
              "description": "Email domain suffixes (e.g. @mycompany.com) whose messages should always be starred.",
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unsubscribeAfterDays": {
              "description": "Auto-unsubscribe from newsletters unread for this many days (default 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "deleteSpam": {
              "description": "If true, spam threads are moved to trash each run.",
              "type": "boolean"
            },
            "notificationFrequency": {
              "description": "How often to email a summary (default action-only).",
              "type": "string",
              "enum": [
                "action-only",
                "daily",
                "every-run"
              ]
            },
            "notificationEmail": {
              "description": "Email address to send summaries to. Defaults to the Google account running the script.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
